{
  "name": "matbot-local-agent-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Windows-native Matbot local assistant scaffold with Mem0 memory and controlled file context.",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "node --test tests/*.test.mjs",
    "test:cli": "corepack pnpm -C local-agent/matbot --filter @matatbread/matbot-cli run test",
    "test:webui": "playwright test",
    "test:readme-qa": "playwright test --config playwright.readme-qa.config.mjs",
    "test:all": "npm test && npm run test:cli && npm run test:webui",
    "eval:cortex": "node scripts/evaluate.mjs",
    "verify:openai": "node tests/verify-openai-key.mjs"
  },
  "workspaces": [
    "local-agent/http-utils",
    "local-agent/paths",
    "local-agent/file-broker",
    "local-agent/file-index",
    "local-agent/matbot/plugins/expert-panel",
    "local-agent/matbot/plugins/file-broker",
    "local-agent/matbot/plugins/hybrid-knowledge-index"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
