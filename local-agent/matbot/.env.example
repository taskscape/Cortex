# Copy this file to .env in the same workspace directory as matbot.yaml.
# Real .env files are gitignored.
#
# Providers in matbot.yaml can reference values with ${NAME}.
# The default hosted OpenAI provider expects OPENAI_API_KEY.
OPENAI_API_KEY=your-openai-api-key-here

# Optional service overrides. start-local-agent.ps1 supplies these defaults when
# they are not already set in the process environment.
# FILE_INDEX_BASE_URL=http://localhost:8877
# FILE_BROKER_BASE_URL=http://localhost:8878
# MEM0_BASE_URL=http://localhost:8888
# MEM0_API_KEY=your-mem0-api-key-here

# Workspace RAG V2 hybrid retrieval is primary by default, with automatic V1
# fallback until a V2 generation is published. Set "shadow" to record V2
# retrieval without changing answers, or "off" to disable V2 explicitly.
CORTEX_RAG_V2_MODE=primary
# CORTEX_RAG_V1_BACKGROUND_SCAN=1
# CORTEX_RAG_V2_POSTGRES_SCHEMA=workspace_rag_v2
# CORTEX_RAG_V2_OBJECT_ROOT=C:\CortexData\workspace-rag-v2
# CORTEX_RAG_V2_OBJECT_RETENTION=managed
# CORTEX_RAG_V2_EXTERNAL_OBJECT_ROOT=D:\ImmutableCortexObjects
# CORTEX_RAG_V2_EAGER_MAX_BYTES=20971520
# CORTEX_RAG_V2_ASYNC_MAX_BYTES=262144000
# CORTEX_RAG_V2_EAGER_PASSAGE_VECTOR_CAP=20000
# CORTEX_RAG_V2_PARSER_MEMORY_BYTES=33554432
# CORTEX_RAG_V2_RERANKER_URL=http://127.0.0.1:8891
# CORTEX_RAG_V2_RRF_K=60
# CORTEX_RAG_V2_RRF_WEIGHTS={"exact_reference":2}
# CORTEX_RAG_V2_VECTOR_INDEX_MODE=full
# CORTEX_RAG_V2_COLBERT_URL=http://127.0.0.1:8892
#
# Optional independent backfill limits. Zero means unlimited.
# CORTEX_RAG_V2_STORAGE_BYTES_PER_SECOND=0
# CORTEX_RAG_V2_EMBEDDING_TEXTS_PER_SECOND=0
# CORTEX_RAG_V2_SOURCE_METADATA_OPS_PER_SECOND=0
# CORTEX_RAG_V2_CONTEXT_GRAPH_OPS_PER_SECOND=0
#
# Production defence in depth: connect the application through a non-owner
# role and provide a separate owner URL only for schema migrations/grants.
# CORTEX_RAG_POSTGRES_URL=postgresql://cortex_rag_app:CHANGE_ME@localhost:5432/mem0
# CORTEX_RAG_V2_MIGRATION_POSTGRES_URL=postgresql://mem0:CHANGE_ME@localhost:5432/mem0
# CORTEX_RAG_V2_REQUIRE_SEPARATE_DB_ROLES=1
