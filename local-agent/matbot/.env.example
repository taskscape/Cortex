# Copy this file to .env in the same workspace directory as matbot.yaml.
# Real .env files are gitignored.
#
# Providers in matbot.yaml can reference values with ${NAME}.
# The default hosted OpenAI provider expects OPENAI_API_KEY.
OPENAI_API_KEY=your-openai-api-key-here

# Optional service overrides. start-local-agent.ps1 supplies these defaults when
# they are not already set in the process environment.
# FILE_INDEX_BASE_URL=http://localhost:8877
# FILE_BROKER_BASE_URL=http://localhost:8878
# MEM0_BASE_URL=http://localhost:8888
# MEM0_API_KEY=your-mem0-api-key-here
