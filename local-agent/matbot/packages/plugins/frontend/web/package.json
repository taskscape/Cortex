{
  "name": "@matatbread/matbot-frontend-web",
  "matbotRuntime": [
    "node",
    "browser"
  ],
  "version": "0.1.0",
  "description": "Web UI with session management. Node entry serves it over HTTP+SSE; browser entry mounts the same UI in-process. Both share index.html + app.js.",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./static/browser.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@matatbread/matbot-core": "workspace:*",
    "@matatbread/matbot-plugin-api": "workspace:*",
    "@matatbread/matbot-skills": "workspace:*",
    "@matatbread/matbot-workspace-manager-types": "workspace:*",
    "@matatbread/matbot-tool-workspace": "workspace:*",
    "@matatbread/matbot-expert-panel-session": "workspace:*",
    "@matatbread/matbot-capabilities-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
