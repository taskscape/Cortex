# Template for local-agent/docker/mem0/.env (the real .env is gitignored).
# Copy this file to .env and replace every CHANGE_ME with a strong, unique value,
# or let local-agent\scripts\setup-secrets.ps1 generate them for you.
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=CHANGE_ME
POSTGRES_DB=mem0
POSTGRES_USER=mem0
POSTGRES_PASSWORD=CHANGE_ME
NEO4J_PASSWORD=CHANGE_ME
NEO4J_AUTH=neo4j/CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
