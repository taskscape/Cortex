FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models \
    TRANSFORMERS_CACHE=/models

WORKDIR /app

COPY workspace-rag-reranker/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY workspace-rag-reranker/app.py ./app.py
COPY workspace-rag-reranker/healthcheck.py ./healthcheck.py

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=10s --start-period=120s --retries=20 \
  CMD ["python", "/app/healthcheck.py"]

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
